{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",

    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,

    "baseUrl": "./src",
    "paths": {
      "*": ["*"]
    },

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "moduleResolution": "nodenext"
  }
}
