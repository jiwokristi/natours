{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "baseUrl": "./src",
    "paths": {
      "*": ["*"]
    },

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "references": [
    { "path": "./tsconfig.server.json" },
    { "path": "./tsconfig.client.json" }
  ]
}
